[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=08/01/2025,0.1.0.0
CatalogFile=NpuBroadcastMic.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22621

[Models.NTamd64.10.0...22621]
%Provider%=Install, Root\NpuBroadcastMic

[SourceDisksNames]
1=%Provider%

[SourceDisksFiles]
tabletaudiosample.sys=1

[DestinationDirs]
DriverFiles=13

[DriverFiles]
tabletaudiosample.sys

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles

[Install.NT.Services]
AddService=NpuBroadcastMic,0x00000002,Service

[Service]
DisplayName=%Provider%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\tabletaudiosample.sys

[Install.NT.Wdf]
KmdfService=NpuBroadcastMic,Wdf
[Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Install.NT.Interfaces]
AddInterface=%Audio%,WaveMicIn,Wave
AddInterface=%Capture%,WaveMicIn,Wave
AddInterface=%Realtime%,WaveMicIn,Wave
AddInterface=%Audio%,TopologyMicIn,Topology
AddInterface=%Topology%,TopologyMicIn,Topology

[Wave]
AddReg=WaveProperties
[WaveProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Provider%

[Topology]
AddReg=TopologyProperties
[TopologyProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Provider%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

