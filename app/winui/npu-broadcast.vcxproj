  <Target Name="CopyAppAssets" AfterTargets="Build">
    <ItemGroup>
      <WinMlRuntime Include="$(WinMlRoot)\runtimes\win-x64\native\*.dll" />
      <SplitModels Include="$(StageRoot)\models\rnnoise_split\**\*.*" />
      <RoomEchoModels Include="$(StageRoot)\models\room_echo_split\**\*.*" Condition="Exists('$(StageRoot)\models\room_echo_split\room_echo_host.onnx')" />
      <AppIconFile Include="$(MSBuildProjectDirectory)\..\npu-broadcast.ico" />
    </ItemGroup>
    <Copy SourceFiles="@(WinMlRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SplitModels)" DestinationFiles="@(SplitModels->'$(OutDir)models\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RoomEchoModels)" DestinationFiles="@(RoomEchoModels->'$(OutDir)models\room-echo\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AppIconFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(RnnoiseRoot)\COPYING;$(StageRoot)\localvqe\LICENSE;$(WinMlRoot)\license.txt;$(WinMlRoot)\ThirdPartyNotices.txt;$(PkgMicrosoft_WindowsAppSDK)\license.txt;$(PkgMicrosoft_WindowsAppSDK)\NOTICE.txt"
