+static int run_room_echo(const char *input_path, const char *output_path) {
+  using Clock = std::chrono::steady_clock;
+  using Milliseconds = std::chrono::duration<double, std::milli>;
+  if (std::strcmp(input_path, output_path) == 0) return 1;
+  std::unique_ptr<FILE, decltype(&std::fclose)> input(std::fopen(input_path, "rb"), std::fclose);
+  if (!input) return 1;
+  std::unique_ptr<FILE, decltype(&std::fclose)> output(std::fopen(output_path, "wb"), std::fclose);
+  if (!output) return 1;
+  if (_putenv_s("RNNOISE_WINML_ROOM_ECHO", "1") || _putenv_s("RNNOISE_WINML_EP", "npu")) return 1;
+  const auto start = Clock::now();
+  if (rnn_winml_prepare() != 0) return 2;
+  const double startup_ms = Milliseconds(Clock::now() - start).count();
+
+  constexpr size_t hop = 256;
+  std::array<short, hop> pcm{};
+  std::array<float, hop> samples{};
+  std::array<float, hop> result{};
+  std::vector<double> timings;
+  size_t previous_count = 0;
+  bool ok = true;
+  do {
+    const auto count = std::fread(pcm.data(), sizeof(short), pcm.size(), input.get());
+    if (std::ferror(input.get())) { ok = false; break; }
+    for (size_t index = 0; index < hop; ++index) {
+      samples[index] = index < count ? pcm[index] / 32768.0f : 0.0f;
+    }
+    if (!count && !previous_count) break;
+    const auto began = Clock::now();
+    if (rnn_winml_room_echo_hop(samples.data(), result.data()) != 0) { ok = false; break; }
+    timings.push_back(Milliseconds(Clock::now() - began).count());
+    for (size_t index = 0; index < previous_count; ++index) {
+      pcm[index] = std::isfinite(result[index]) ?
+          static_cast<short>(std::clamp(result[index] * 32768.0f, -32768.0f, 32767.0f)) : 0;
+    }
+    if (std::fwrite(pcm.data(), sizeof(short), previous_count, output.get()) != previous_count) {
+      ok = false;
+      break;
+    }
+    previous_count = count;
+  } while (previous_count);
+  rnn_winml_shutdown();
+  if (std::fflush(output.get()) != 0 || !ok || timings.empty()) return 3;
+  const auto elapsed = std::accumulate(timings.begin(), timings.end(), 0.0);
+  const auto late = std::count_if(timings.begin(), timings.end(), [](double ms) { return ms > 16; });
+  std::sort(timings.begin(), timings.end());
+  std::fprintf(stderr, "Room echo: %zu hops, startup %.2f ms, mean %.2f ms, P95 %.2f ms, %zu over 16 ms\n",
+      timings.size(), startup_ms, elapsed / timings.size(), timings[(timings.size() * 95 - 1) / 100], late);
+  return 0;
 }
 
