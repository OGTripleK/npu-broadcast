+extern "C" int rnn_winml_room_echo_hop(const float *input, float *output) {
+  if (init_winml() != 0 || !g_state->echo) return -1;
+  auto &echo = *g_state->echo;
+  std::copy_n(echo.window.data() + kEchoHop, kEchoHop, echo.window.data());
+  std::copy_n(input, kEchoHop, echo.window.data() + kEchoHop);
+  std::array<const OrtValue *, kEchoStates + 1> inputs;
+  std::array<OrtValue *, kEchoStates + 1> outputs;
+  inputs[0] = echo.window_tensor;
+  outputs[0] = echo.result_tensor;
+  for (size_t index = 0; index < kEchoStates; ++index) {
+    inputs[index + 1] = echo.states[index];
+    outputs[index + 1] = echo.next[index];
+  }
+  const auto started = InferenceClock::now();
+  if (!check_status(*g_state, g_state->ort->Run(g_state->session, nullptr, echo.input_names.data(),
+          inputs.data(), inputs.size(), echo.output_names.data(), outputs.size(), outputs.data()),
+          "Run(room echo)")) return -1;
+  set_inference_time(started);
+  echo.states.swap(echo.next);
+  if (!std::getenv("RNNOISE_WINML_ECHO_OVERLAP_ADD")) {
+    // Use the newest half of the model window directly to skip one overlap-add hop.
+    std::copy_n(echo.result.data() + kEchoHop, kEchoHop, output);
+    return 0;
+  }
+  for (size_t index = 0; index < kEchoHop; ++index) {
+    output[index] = 0.5f * (echo.result[index] + echo.tail[index]);
+    echo.tail[index] = echo.result[index + kEchoHop];
+  }
+  return 0;
+}
