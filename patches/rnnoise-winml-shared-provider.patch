+// CreateEnv returns the same ORT environment while any session still owns it.
+struct SharedWinMLEnvironment {
+  explicit SharedWinMLEnvironment(const OrtApi *api) : ort(api) {}
+  ~SharedWinMLEnvironment() {
+    if (env != nullptr) {
+      for (const RegisteredProvider &provider : providers) {
+        OrtStatus *status = ort->UnregisterExecutionProviderLibrary(env, provider.name.c_str());
+        if (status != nullptr) ort->ReleaseStatus(status);
+      }
+      ort->ReleaseEnv(env);
+    }
+    if (catalog != nullptr) WinMLEpCatalogRelease(catalog);
+  }
+
+  const OrtApi *ort;
+  OrtEnv *env = nullptr;
+  WinMLEpCatalogHandle catalog = nullptr;
+  std::vector<RegisteredProvider> providers;
+};
